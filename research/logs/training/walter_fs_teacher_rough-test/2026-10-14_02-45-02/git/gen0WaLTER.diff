+def _forward_bin_medians(
+  z: torch.Tensor,
+  bin_id: torch.Tensor,
+  forward: torch.Tensor,
+) -> torch.Tensor:
+  """Median height of each forward bin. Empty bins are NaN."""
+  columns = [
